<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="586.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empresamonedero.ViewController.TransferenciaViewController">
   <children>
      <Text layoutX="158.0" layoutY="50.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ingrese los documentos de la transferencia" />
      <TextField fx:id="txtCodigoMonedero" layoutX="206.0" layoutY="129.0" prefHeight="31.0" prefWidth="187.0" promptText="codigo monedero" />
      <TextField fx:id="txtMonto" layoutX="206.0" layoutY="200.0" promptText="monto" />
      <Button fx:id="btnTransferencia" layoutX="220.0" layoutY="305.0" mnemonicParsing="false" onAction="#transferenciaEvent" text="Realizar transferencia" />
      <TextField fx:id="txtCodigoTransferencia" layoutX="206.0" layoutY="76.0" promptText="codigo transferencia" />
   </children>
</AnchorPane>
