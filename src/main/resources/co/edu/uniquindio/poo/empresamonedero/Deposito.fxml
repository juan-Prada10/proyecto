   <children>
      <Text layoutX="211.0" layoutY="49.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ingrese los datos del deposito" />
      <TextField fx:id="txtMonto" layoutX="201.0" layoutY="200.0" promptText="monto" />
      <TextField fx:id="txtCodigoMonedero" layoutX="201.0" layoutY="155.0" promptText="codigo del monedero" />
      <Button fx:id="btnCrearDeposito" layoutX="236.0" layoutY="301.0" mnemonicParsing="false" onAction="#crearDepositoEvent" text="Crear deposito" />
      <TextField fx:id="txtDeposito" layoutX="201.0" layoutY="105.0" promptText="Codigo del deposito" />
   </children>
</AnchorPane>
