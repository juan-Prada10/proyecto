<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="314.0" prefWidth="276.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empresamonedero.ViewController.DepositoViewController">
   <children>
      <Text fill="#ffdd00" layoutX="26.0" layoutY="59.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ingrese los datos del deposito">
         <font>
            <Font name="Agency FB" size="24.0" />
         </font></Text>
      <TextField fx:id="txtMonto" alignment="CENTER" layoutX="64.0" layoutY="194.0" promptText="Monto" style="-fx-background-color: ffffff; -fx-text-fill: #000000; -fx-prompt-text-fill: #716414;" />
      <TextField fx:id="txtCodigoMonedero" alignment="CENTER" layoutX="64.0" layoutY="144.0" promptText="Código del monedero" style="-fx-background-color: ffffff; -fx-prompt-text-fill: #716414; -fx-text-fill: #000000;" />
      <Button fx:id="btnCrearDeposito" layoutX="95.0" layoutY="246.0" mnemonicParsing="false" onAction="#crearDepositoEvent" style="-fx-background-color: ffdf00;" text="Crear deposito">
         <font>
            <Font name="Agency FB" size="14.0" />
         </font></Button>
      <TextField fx:id="txtDeposito" alignment="CENTER" layoutX="63.0" layoutY="93.0" promptText="Código del deposito" style="-fx-background-color: ffffff; -fx-prompt-text-fill: #716414; -fx-text-fill: #000000;" />
   </children>
</AnchorPane>
